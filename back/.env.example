# ---------- Server ----------
PORT=3000

# timezone ที่ใช้คำนวณขอบเขตวัน (แคมเปญ, เป้าหมายรายเดือน, กราฟรายวัน)
# ต้องตรงกับ VITE_APP_TIMEZONE ฝั่ง frontend
APP_TIMEZONE=Asia/Bangkok

DATABASE_URL="postgresql://user:password@localhost:5432/donation_db"

# origin ของ frontend ที่อนุญาตให้เรียก API ได้ (คั่นด้วย , ถ้ามีหลายอัน)
CORS_ORIGIN=http://localhost:5173

# ---------- SlipOK (ตรวจสอบสลิปโอนเงิน) ----------
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=

# ---------- Admin login ----------
ADMIN_USERNAME=admin

# hash ของรหัสผ่าน ไม่ใช่ตัวรหัสผ่านเอง สร้างด้วย:
#   node -e "console.log(require('bcrypt').hashSync('รหัสผ่านของคุณ', 10))"
ADMIN_PASSWORD_HASH=

# ---------- JWT ----------
# สุ่มด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ---------- Signed URL ของรูปสลิป ----------
# ใช้เซ็นลิงก์ดูสลิป (อายุ 15 นาที) สุ่มแบบเดียวกับ JWT_SECRET
UPLOADS_SIGNING_SECRET=

# ---------- Text-to-Speech ----------
# ต้องติดตั้ง Python และ edge-tts ก่อน: pip install edge-tts
# เว้นว่างไว้ได้ ระบบจะเดาให้เอง (Windows ใช้ "py", ที่อื่นใช้ "python3")
PYTHON_BIN=
